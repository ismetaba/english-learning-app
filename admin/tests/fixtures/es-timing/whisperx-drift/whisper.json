{"segments": [{"text": "¡Uno, dos, tres, cuatro, cinco, seis, septópodo!", "start": 101.559, "end": 103.181, "words": [{"word": "¡Uno,", "start": 101.559, "end": 101.699, "score": 0.446}, {"word": "dos,", "start": 101.739, "end": 101.879, "score": 0.527}, {"word": "tres,", "start": 101.919, "end": 102.04, "score": 0.323}, {"word": "cuatro,", "start": 102.06, "end": 102.28, "score": 0.343}, {"word": "cinco,", "start": 102.3, "end": 102.48, "score": 0.599}, {"word": "seis,", "start": 102.52, "end": 102.76, "score": 0.457}, {"word": "septópodo!", "start": 102.78, "end": 103.181, "score": 0.426}]}, {"text": "¡Se camufló!", "start": 103.441, "end": 103.981, "words": [{"word": "¡Se", "start": 103.441, "end": 103.621, "score": 0.545}, {"word": "camufló!", "start": 103.641, "end": 103.981, "score": 0.37}]}, {"text": "¡Kang!", "start": 104.001, "end": 104.202, "words": [{"word": "¡Kang!", "start": 104.001, "end": 104.202, "score": 0.385}]}, {"text": "¡Arriba, Gang!", "start": 104.222, "end": 104.662, "words": [{"word": "¡Arriba,", "start": 104.222, "end": 104.402, "score": 0.098}, {"word": "Gang!", "start": 104.422, "end": 104.662, "score": 0.433}]}, {"text": "¡Hay que irnos!", "start": 104.682, "end": 105.043, "words": [{"word": "¡Hay", "start": 104.682, "end": 104.762, "score": 0.048}, {"word": "que", "start": 104.782, "end": 104.842, "score": 0.151}, {"word": "irnos!", "start": 104.882, "end": 105.043, "score": 0.201}]}, {"text": "¿Qué estás haciendo?", "start": 105.083, "end": 105.683, "words": [{"word": "¿Qué", "start": 105.083, "end": 105.183, "score": 0.205}, {"word": "estás", "start": 105.203, "end": 105.343, "score": 0.171}, {"word": "haciendo?", "start": 105.383, "end": 105.683, "score": 0.27}]}, {"text": "¡Gang!", "start": 105.703, "end": 105.863, "words": [{"word": "¡Gang!", "start": 105.703, "end": 105.863, "score": 0.217}]}, {"text": "¿Cuál es el plan?", "start": 114.523, "end": 115.324, "words": [{"word": "¿Cuál", "start": 114.523, "end": 114.663, "score": 0.184}, {"word": "es", "start": 114.723, "end": 114.763, "score": 0.303}, {"word": "el", "start": 114.843, "end": 114.983, "score": 0.647}, {"word": "plan?", "start": 115.083, "end": 115.324, "score": 0.69}]}, {"text": "El plan es que me quedaré aquí para siempre.", "start": 115.424, "end": 117.445, "words": [{"word": "El", "start": 115.424, "end": 115.504, "score": 0.7}, {"word": "plan", "start": 115.624, "end": 115.884, "score": 0.399}, {"word": "es", "start": 115.924, "end": 115.964, "score": 0.561}, {"word": "que", "start": 115.984, "end": 116.064, "score": 0.214}, {"word": "me", "start": 116.104, "end": 116.184, "score": 0.505}, {"word": "quedaré", "start": 116.224, "end": 116.545, "score": 0.349}, {"word": "aquí", "start": 116.565, "end": 116.725, "score": 0.378}, {"word": "para", "start": 116.765, "end": 116.905, "score": 0.578}, {"word": "siempre.", "start": 117.045, "end": 117.445, "score": 0.48}]}, {"text": "Ok.", "start": 117.545, "end": 117.726, "words": [{"word": "Ok.", "start": 117.545, "end": 117.726, "score": 0.606}]}, {"text": "Buen plan.", "start": 117.786, "end": 118.226, "words": [{"word": "Buen", "start": 117.786, "end": 117.906, "score": 0.262}, {"word": "plan.", "start": 117.926, "end": 118.226, "score": 0.379}]}, {"text": "¡Perdón!", "start": 118.246, "end": 118.546, "words": [{"word": "¡Perdón!", "start": 118.246, "end": 118.546, "score": 0.484}]}, {"text": "Lo lamento.", "start": 118.566, "end": 119.047, "words": [{"word": "Lo", "start": 118.566, "end": 118.606, "score": 0.006}, {"word": "lamento.", "start": 118.626, "end": 119.047, "score": 0.574}]}, {"text": "Lamento que nunca me puedo acordar.", "start": 119.067, "end": 120.908, "words": [{"word": "Lamento", "start": 119.067, "end": 119.407, "score": 0.481}, {"word": "que", "start": 119.427, "end": 119.547, "score": 0.247}, {"word": "nunca", "start": 119.567, "end": 119.827, "score": 0.568}, {"word": "me", "start": 119.867, "end": 120.127, "score": 0.674}, {"word": "puedo", "start": 120.147, "end": 120.448, "score": 0.56}, {"word": "acordar.", "start": 120.468, "end": 120.908, "score": 0.42}]}, {"text": "¡Cielo!", "start": 120.988, "end": 121.448, "words": [{"word": "¡Cielo!", "start": 120.988, "end": 121.448, "score": 0.577}]}, {"text": "¡Cielo!", "start": 121.508, "end": 121.809, "words": [{"word": "¡Cielo!", "start": 121.508, "end": 121.809, "score": 0.285}]}, {"text": "¡Cielo!", "start": 121.849, "end": 122.209, "words": [{"word": "¡Cielo!", "start": 121.849, "end": 122.209, "score": 0.383}]}, {"text": "¡Cuidado, escavitas!", "start": 122.289, "end": 123.15, "words": [{"word": "¡Cuidado,", "start": 122.289, "end": 122.669, "score": 0.505}, {"word": "escavitas!", "start": 122.689, "end": 123.15, "score": 0.528}]}, {"text": "¡Ten más cuidado!", "start": 123.17, "end": 123.81, "words": [{"word": "¡Ten", "start": 123.17, "end": 123.31, "score": 0.441}, {"word": "más", "start": 123.33, "end": 123.41, "score": 0.193}, {"word": "cuidado!", "start": 123.45, "end": 123.81, "score": 0.513}]}, {"text": "Perdón, papi.", "start": 123.87, "end": 124.811, "words": [{"word": "Perdón,", "start": 123.87, "end": 124.211, "score": 0.407}, {"word": "papi.", "start": 124.231, "end": 124.811, "score": 0.623}]}, {"text": "Perdón por no poderme acordarte.", "start": 124.971, "end": 126.392, "words": [{"word": "Perdón", "start": 124.971, "end": 125.211, "score": 0.391}, {"word": "por", "start": 125.231, "end": 125.351, "score": 0.402}, {"word": "no", "start": 125.411, "end": 125.451, "score": 0.072}, {"word": "poderme", "start": 125.471, "end": 125.832, "score": 0.397}, {"word": "acordarte.", "start": 125.912, "end": 126.392, "score": 0.537}]}, {"text": "Ay, nena.", "start": 126.412, "end": 127.053, "words": [{"word": "Ay,", "start": 126.412, "end": 126.492, "score": 0.3}, {"word": "nena.", "start": 126.512, "end": 127.053, "score": 0.694}]}, {"text": "No, nena.", "start": 127.133, "end": 127.973, "words": [{"word": "No,", "start": 127.133, "end": 127.333, "score": 0.614}, {"word": "nena.", "start": 127.593, "end": 127.973, "score": 0.588}]}, {"text": "No hay nada que perdonar, ¿sí?", "start": 128.114, "end": 138.622, "words": [{"word": "No", "start": 128.114, "end": 128.314, "score": 0.723}, {"word": "hay", "start": 128.354, "end": 128.474, "score": 0.476}, {"word": "nada", "start": 128.494, "end": 128.794, "score": 0.638}, {"word": "que", "start": 128.814, "end": 130.756, "score": 0.461}, {"word": "perdonar,", "start": 130.816, "end": 138.381, "score": 0.649}, {"word": "¿sí?", "start": 138.401, "end": 138.622, "score": 0.534}]}, {"text": "¿Te digo lo que hay que hacer?", "start": 139.082, "end": 140.483, "words": [{"word": "¿Te", "start": 139.082, "end": 139.222, "score": 0.466}, {"word": "digo", "start": 139.282, "end": 139.542, "score": 0.791}, {"word": "lo", "start": 139.602, "end": 139.682, "score": 0.884}, {"word": "que", "start": 139.722, "end": 139.823, "score": 0.761}, {"word": "hay", "start": 139.863, "end": 139.983, "score": 0.757}, {"word": "que", "start": 140.003, "end": 140.103, "score": 0.763}, {"word": "hacer?", "start": 140.123, "end": 140.483, "score": 0.766}]}, {"text": "Solo...", "start": 141.344, "end": 141.604, "words": [{"word": "Solo...", "start": 141.344, "end": 141.604, "score": 0.423}]}, {"text": "Nadaremos.", "start": 142.727, "end": 143.147, "words": [{"word": "Nadaremos.", "start": 142.727, "end": 143.147, "score": 0.403}]}, {"text": "Sí.", "start": 143.667, "end": 144.068, "words": [{"word": "Sí.", "start": 143.667, "end": 144.068, "score": 0.6}]}, {"text": "Y apuesto que no lo vas a olvidar porque juntos vamos a cantar sobre eso.", "start": 144.468, "end": 150.59, "words": [{"word": "Y", "start": 144.468, "end": 144.508, "score": 0.895}, {"word": "apuesto", "start": 144.568, "end": 144.888, "score": 0.849}, {"word": "que", "start": 144.948, "end": 145.028, "score": 0.825}, {"word": "no", "start": 145.108, "end": 145.188, "score": 0.992}, {"word": "lo", "start": 145.248, "end": 145.328, "score": 0.902}, {"word": "vas", "start": 145.388, "end": 145.548, "score": 0.707}, {"word": "a", "start": 145.568, "end": 145.588, "score": 0.073}, {"word": "olvidar", "start": 145.628, "end": 146.029, "score": 0.952}, {"word": "porque", "start": 146.149, "end": 146.449, "score": 0.938}, {"word": "juntos", "start": 146.929, "end": 147.329, "score": 0.894}, {"word": "vamos", "start": 147.749, "end": 149.63, "score": 0.792}, {"word": "a", "start": 149.69, "end": 149.71, "score": 0.795}, {"word": "cantar", "start": 149.79, "end": 150.09, "score": 0.922}, {"word": "sobre", "start": 150.17, "end": 150.37, "score": 0.781}, {"word": "eso.", "start": 150.45, "end": 150.59, "score": 0.627}]}, {"text": "Nadaremos, nadaremos.", "start": 150.971, "end": 153.572, "words": [{"word": "Nadaremos,", "start": 150.971, "end": 152.211, "score": 0.926}, {"word": "nadaremos.", "start": 152.371, "end": 153.572, "score": 0.921}]}, {"text": "En el mar, el mar, el mar.", "start": 153.812, "end": 156.213, "words": [{"word": "En", "start": 153.812, "end": 153.932, "score": 0.718}, {"word": "el", "start": 154.192, "end": 154.372, "score": 0.718}, {"word": "mar,", "start": 154.452, "end": 154.912, "score": 0.735}, {"word": "el", "start": 155.032, "end": 155.092, "score": 0.316}, {"word": "mar,", "start": 155.132, "end": 155.313, "score": 0.708}, {"word": "el", "start": 155.533, "end": 155.633, "score": 0.696}, {"word": "mar.", "start": 155.793, "end": 156.213, "score": 0.681}]}, {"text": "¿Qué hay que hacer?", "start": 156.233, "end": 157.393, "words": [{"word": "¿Qué", "start": 156.233, "end": 156.873, "score": 0.578}, {"word": "hay", "start": 156.893, "end": 156.993, "score": 0.376}, {"word": "que", "start": 157.013, "end": 157.113, "score": 0.656}, {"word": "hacer?", "start": 157.133, "end": 157.393, "score": 0.64}]}, {"text": "Nadar, nadar.", "start": 157.533, "end": 158.614, "words": [{"word": "Nadar,", "start": 157.533, "end": 157.794, "score": 0.344}, {"word": "nadar.", "start": 157.894, "end": 158.614, "score": 0.671}]}]}